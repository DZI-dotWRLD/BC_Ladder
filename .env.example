# Local development defaults
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=bc-ladder-development-only-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=America/New_York
DJANGO_LOG_LEVEL=INFO

# Password-reset email is printed to the development console by default.
# Configure SMTP in a deployed environment.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=<smtp-username>
# DJANGO_EMAIL_HOST_PASSWORD=<smtp-password>
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_EMAIL_USE_SSL=false
# DJANGO_EMAIL_TIMEOUT=10
# DJANGO_DEFAULT_FROM_EMAIL=BC Tennis Ladder <no-reply@example.com>
# DJANGO_PASSWORD_RESET_TIMEOUT=3600

# SQLite is the default when DATABASE_URL and DJANGO_DB_* are not set.
# DATABASE_URL=postgresql://bc_ladder:<password>@localhost:5432/bc_ladder

# Manual PostgreSQL alternative
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=bc_ladder
# DJANGO_DB_USER=bc_ladder
# DJANGO_DB_PASSWORD=<password>
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# Production / Render-style security settings
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<rotated-secret-at-least-32-chars>
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
# DJANGO_SECURE_PROXY_SSL_HEADER_VALUE=https
# DJANGO_SECURE_HSTS_SECONDS=300
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false
# DJANGO_WHITENOISE_MANIFEST_STRICT=true
